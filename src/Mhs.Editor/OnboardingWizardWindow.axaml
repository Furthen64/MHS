<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Mhs.Editor.ViewModels"
        x:Class="Mhs.Editor.OnboardingWizardWindow"
        x:DataType="vm:OnboardingWizardViewModel"
        mc:Ignorable="d"
        Width="560"
        Height="320"
        MinWidth="520"
        MinHeight="280"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="Welcome to MHS Editor">
    <Grid RowDefinitions="Auto,*,Auto" Margin="18">
        <StackPanel Spacing="8">
            <TextBlock Text="Onboarding setup wizard" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Pick the GPU to prefer for the OpenGL spike viewport." />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,14,0,0" Spacing="8">
            <TextBlock Text="Graphics card" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding AvailableGpus}"
                      SelectedItem="{Binding SelectedGpu, Mode=TwoWay}" />
            <TextBlock Text="Tip: choose the NVIDIA GeForce GPU on dual-GPU laptops."
                       Foreground="{DynamicResource ThemeBrush_808080}" />
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0"
                    Spacing="10">
            <Button Content="Cancel" Click="OnCancelClick" />
            <Button Content="Save and Continue" Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</Window>
