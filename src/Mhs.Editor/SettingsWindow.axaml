<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Mhs.Editor.ViewModels"
        x:Class="Mhs.Editor.SettingsWindow"
        x:DataType="vm:SettingsWindowViewModel"
        mc:Ignorable="d"
        Width="620"
        Height="480"
        MinWidth="560"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Title="Settings"
        Background="{DynamicResource ThemeBrush_161A21}"
        Foreground="{DynamicResource ThemeBrush_E7EDF5}">
    <Window.Styles>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_F4F7FB}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_C8D4E2}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_AEBAC8}" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_202632}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_3E4A5E}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_1D3950}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_F5FAFF}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_8FC7FF}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,8" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_293241}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_E7EDF5}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_3E4A5E}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,8" />
        </Style>
    </Window.Styles>

    <Border Margin="12"
            Background="{DynamicResource ThemeBrush_161A21}"
            BorderBrush="{DynamicResource ThemeBrush_2B3442}"
            BorderThickness="1"
            CornerRadius="14">
        <Grid RowDefinitions="Auto,*,Auto">
            <Border Background="{DynamicResource ThemeBrush_1B212C}"
                    BorderBrush="{DynamicResource ThemeBrush_2E394A}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0"
                    Padding="20,18,20,16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Application settings"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeBrush_F4F7FB}" />
                        <TextBlock Text="Tune startup behavior, GPU preference, theme, and default scene settings."
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Background="{DynamicResource ThemeBrush_203246}"
                            BorderBrush="{DynamicResource ThemeBrush_4D7BA4}"
                            BorderThickness="1"
                            CornerRadius="999"
                            Padding="10,6"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                        <TextBlock Text="Readable theme"
                                   Foreground="{DynamicResource ThemeBrush_8FC7FF}"
                                   FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="20,18,20,0" Spacing="14">
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Width="10"
                                    Height="10"
                                    CornerRadius="999"
                                    Background="{DynamicResource ThemeBrush_8FC7FF}"
                                    VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Startup" Classes="sectionTitle" />
                        </Grid>

                        <TextBlock Text="Control how the editor boots and which rendering path it prefers."
                                   Classes="muted"
                                   TextWrapping="Wrap" />

                        <CheckBox Content="Open maximized"
                                  Foreground="{DynamicResource ThemeBrush_EDF3FA}"
                                  IsChecked="{Binding OpenMaximized, Mode=TwoWay}" />

                        <Grid ColumnDefinitions="170,*"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="12"
                              RowSpacing="12">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Preferred GPU" Classes="fieldLabel" />
                            <ComboBox Grid.Row="0"
                                      Grid.Column="1"
                                      MinWidth="220"
                                      ItemsSource="{Binding AvailableGpus}"
                                      SelectedItem="{Binding SelectedGpu, Mode=TwoWay}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Default renderer" Classes="fieldLabel" />
                            <ComboBox Grid.Row="1"
                                      Grid.Column="1"
                                      MinWidth="220"
                                      ItemsSource="{Binding AvailableRendererModes}"
                                      SelectedItem="{Binding SelectedRendererMode, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Width="10"
                                    Height="10"
                                    CornerRadius="999"
                                    Background="{DynamicResource ThemeBrush_9AD28E}"
                                    VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Workspace" Classes="sectionTitle" />
                        </Grid>

                        <TextBlock Text="Set the defaults new scenes inherit when they are created."
                                   Classes="muted"
                                   TextWrapping="Wrap" />

                        <Grid ColumnDefinitions="170,*"
                              RowDefinitions="Auto,Auto,Auto,Auto"
                              ColumnSpacing="12"
                              RowSpacing="12">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="View mode" Classes="fieldLabel" />
                            <ComboBox Grid.Row="0"
                                      Grid.Column="1"
                                      MinWidth="220"
                                      ItemsSource="{Binding AvailableUiModes}"
                                      SelectedItem="{Binding SelectedUiMode, Mode=TwoWay}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Theme" Classes="fieldLabel" />
                            <ComboBox Grid.Row="1"
                                      Grid.Column="1"
                                      MinWidth="220"
                                      ItemsSource="{Binding AvailableThemeModes}"
                                      SelectedItem="{Binding SelectedThemeMode, Mode=TwoWay}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Default floor" Classes="fieldLabel" />
                            <ComboBox Grid.Row="2"
                                      Grid.Column="1"
                                      MinWidth="220"
                                      ItemsSource="{Binding AvailableFloors}"
                                      SelectedItem="{Binding DefaultFloor, Mode=TwoWay}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Default layer" Classes="fieldLabel" />
                            <ComboBox Grid.Row="3"
                                      Grid.Column="1"
                                      MinWidth="220"
                                      ItemsSource="{Binding AvailableLayers}"
                                      SelectedItem="{Binding DefaultLayer, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource ThemeBrush_1B2633}"
                        BorderBrush="{DynamicResource ThemeBrush_32455C}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,10">
                    <TextBlock Text="Theme changes apply immediately when you save settings. GPU preference changes are saved immediately for future launches; the active OpenGL context may still need a restart to fully switch devices."
                               Classes="muted"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <Border Grid.Row="2"
                    Background="{DynamicResource ThemeBrush_1B212C}"
                    BorderBrush="{DynamicResource ThemeBrush_2E394A}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,14,14"
                    Padding="20,14,20,18"
                    Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="10">
                    <Button Content="Cancel" Classes="secondary" Click="OnCancelClick" />
                    <Button Content="Save settings" Classes="primary" Click="OnSaveClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
