<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Mhs.Editor.ViewModels"
        xmlns:viewport="clr-namespace:Mhs.Editor.Viewport"
        mc:Ignorable="d"
        x:DataType="vm:MainWindowViewModel"
        d:DesignWidth="1600"
        d:DesignHeight="950"
        x:Class="Mhs.Editor.MainWindow"
        Title="MHS Editor PoC"
        Width="1600"
        Height="950"
        MinWidth="900"
        MinHeight="600">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="☰">
                <MenuItem Header="_Settings">
                    <MenuItem Header="_Application Settings..." Click="OnSettingsClick" />
                    <Separator />
                    <MenuItem Header="I want _Blender like settings"
                              IsChecked="{Binding IsBlenderLikeSettingsActive}"
                              Command="{Binding BlenderLikeSettingsCommand}" />
                    <MenuItem Header="I want _AutoCAD like settings"
                              IsChecked="{Binding IsAutoCadLikeSettingsActive}"
                              Command="{Binding AutoCadLikeSettingsCommand}" />
                    <Separator />
                    <MenuItem Header="OpenGL _GPU Setup..." Click="OnOpenGlGpuSetupClick" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_File">
                <MenuItem Header="_New" Click="OnNewSceneClick" />
                <MenuItem Header="_Open..." Click="OnOpenSceneClick" />
                <MenuItem Header="_Save" Click="OnSaveSceneClick" />
                <MenuItem Header="Save _As..." Click="OnSaveSceneAsClick" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExitClick" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Background="#2A2E36" Padding="8">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Foreground="#E5E9F0"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Text="Material Handling System Editor - PoC 3" />
                <Button DockPanel.Dock="Right"
                        Padding="10,4"
                        Background="#3A4250"
                        Foreground="#F3F6FB"
                        BorderBrush="#5C6B7F"
                        BorderThickness="1"
                        CornerRadius="6"
                        Click="OnSettingsClick">
                    <TextBlock Text="⚙️" FontSize="16" />
                </Button>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#20232A" Padding="8,6">
            <TextBlock Foreground="#D8DEE9" Text="{Binding StatusText}" />
        </Border>

        <Grid ColumnDefinitions="220,*,300" Background="#1B1D23">
            <DockPanel Grid.Column="0" Margin="8" LastChildFill="True">
                <Border DockPanel.Dock="Top" Padding="10" Background="#232833" CornerRadius="4" Margin="0,0,0,6">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Parts Palette" FontWeight="Bold" Foreground="#ECEFF4" FontSize="14" />
                        <RadioButton Content="Select" GroupName="Tools" IsChecked="{Binding IsSelectActive}" Command="{Binding SelectToolCommand}" />
                        <RadioButton Content="Hopper" GroupName="Tools" IsChecked="{Binding IsHopperActive}" Command="{Binding HopperToolCommand}" />
                        <RadioButton Content="Bin" GroupName="Tools" IsChecked="{Binding IsBinActive}" Command="{Binding BinToolCommand}" />
                        <RadioButton Content="Conveyor Route" GroupName="Tools" IsChecked="{Binding IsConveyorRouteActive}" Command="{Binding ConveyorRouteToolCommand}" />
                        <RadioButton Content="Chute" GroupName="Tools" IsChecked="{Binding IsChuteActive}" Command="{Binding ChuteToolCommand}" />
                        <RadioButton Content="Tall Hopper" GroupName="Tools" IsChecked="{Binding IsTallHopperActive}" Command="{Binding TallHopperToolCommand}" />
                        <RadioButton Content="MtrlSrc" GroupName="Tools" IsChecked="{Binding IsMtrlSrcActive}" Command="{Binding MtrlSrcToolCommand}" />
                        <RadioButton Content="MtrlRecv" GroupName="Tools" IsChecked="{Binding IsMtrlRecvActive}" Command="{Binding MtrlRecvToolCommand}" />
                    </StackPanel>
                </Border>

                <Border Padding="8" Background="#1A1F29" CornerRadius="4">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Scene Objects"
                                   FontWeight="Bold"
                                   Foreground="#ECEFF4"
                                   FontSize="13"
                                   Margin="0,0,0,6" />
                        <ScrollViewer>
                            <ListBox x:Name="SceneTreeListBox"
                                     ItemsSource="{Binding SceneTreeNodes}"
                                     SelectedItem="{Binding SelectedSceneTreeNode, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     SelectionChanged="OnSceneTreeSelectionChanged"
                                     DoubleTapped="OnSceneTreeDoubleTapped">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="4,3" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="Margin" Value="0,1" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="1" />
                                    </Style>
                                    <Style Selector="ListBoxItem:selected">
                                        <Setter Property="Background" Value="#2B3E58" />
                                        <Setter Property="BorderBrush" Value="#88B8FF" />
                                    </Style>
                                    <Style Selector="ListBoxItem:pointerover:not(:selected)">
                                        <Setter Property="Background" Value="#1F2934" />
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SceneTreeNodeViewModel">
                                        <Panel>
                                            <TextBlock Text="{Binding Label}"
                                                       IsVisible="{Binding IsGroupHeader}"
                                                       Foreground="#5E7A94"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Margin="{Binding ContentMargin}" />
                                            <StackPanel IsVisible="{Binding !IsGroupHeader}" Spacing="1" Margin="{Binding ContentMargin}">
                                                <TextBlock Text="{Binding Label}"
                                                           Foreground="#C8D8E8"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding StatusText}"
                                                           IsVisible="{Binding HasStatus}"
                                                           Foreground="#6FADB5"
                                                           FontSize="10"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Panel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </DockPanel>

            <Border Grid.Column="1"
                    Grid.ColumnSpan="{Binding SceneViewportColumnSpan}"
                    Margin="8"
                    Background="#121519"
                    CornerRadius="4"
                    BorderThickness="1"
                    BorderBrush="#3B4252">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#1A1F27" Padding="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Floor:" Foreground="#E5E9F0" VerticalAlignment="Center" />
                                <RadioButton Content="0" GroupName="FloorSelect" IsChecked="{Binding IsFloor0Active}" Command="{Binding Floor0Command}" />
                                <RadioButton Content="1" GroupName="FloorSelect" IsChecked="{Binding IsFloor1Active}" Command="{Binding Floor1Command}" />
                                <RadioButton Content="2" GroupName="FloorSelect" IsChecked="{Binding IsFloor2Active}" Command="{Binding Floor2Command}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding LayerDisplayText}" Foreground="#E5E9F0" VerticalAlignment="Center" />
                                <RadioButton Content="0" GroupName="LayerSelect" IsChecked="{Binding IsLayer0Active}" Command="{Binding Layer0Command}" />
                                <RadioButton Content="1" GroupName="LayerSelect" IsChecked="{Binding IsLayer1Active}" Command="{Binding Layer1Command}" />
                                <RadioButton Content="2" GroupName="LayerSelect" IsChecked="{Binding IsLayer2Active}" Command="{Binding Layer2Command}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Renderer:" Foreground="#E5E9F0" VerticalAlignment="Center" />
                                <RadioButton Content="Software" GroupName="RendererMode" IsChecked="{Binding IsSoftwareViewportMode}" Command="{Binding UseSoftwareViewportCommand}" />
                                <RadioButton Content="OpenGL Spike" GroupName="RendererMode" IsChecked="{Binding IsOpenGlViewportMode}" Command="{Binding UseOpenGlViewportCommand}" />
                            </StackPanel>
                            <CheckBox Content="Show Conveyor Debug"
                                      IsChecked="{Binding ShowConveyorDebug, Mode=TwoWay}"
                                      Foreground="#D8DEE9"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="{Binding AbsoluteZDisplayText}" Foreground="#D8DEE9" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Grid>
                    <viewport:SoftwareCubeViewport x:Name="SoftwareViewport"
                                                   IsVisible="{Binding IsSoftwareViewportMode}"
                                                   EditorState="{Binding EditorState}"
                                                       InteractionPreset="{Binding InteractionPreset}" />
                    <viewport:OpenGlViewportControl x:Name="OpenGlViewport"
                                                       IsVisible="{Binding IsOpenGlViewportMode}"
                                                        EditorState="{Binding EditorState}"
                                                        InteractionPreset="{Binding InteractionPreset}" />

                        <Border IsVisible="{Binding FloatingDebugPanelVisible}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="14"
                                MaxWidth="380"
                                Padding="12"
                                Background="#D9131820"
                                BorderBrush="#586A82"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Conveyor Debug" FontWeight="Bold" Foreground="#F3F6FB" />
                                <TextBlock Text="{Binding ConveyorDebugSelectionText}" Foreground="#D8DEE9" />
                                <TextBlock Text="{Binding ConveyorDebugRouteSummaryText}" Foreground="#BFD2EA" TextWrapping="Wrap" />
                                <Border Background="#0F1217"
                                        BorderBrush="#374657"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8">
                                    <TextBlock Text="{Binding ConveyorDebugGridText}"
                                               Foreground="#E5E9F0"
                                               FontFamily="Consolas"
                                               TextWrapping="NoWrap" />
                                </Border>
                                <TextBlock Text="{Binding ConveyorDebugLegendText}" Foreground="#8EACCC" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="Inject DebugOre" Command="{Binding InjectDebugOreCommand}" />
                                    <Button Content="Step Flow" Command="{Binding StepMaterialFlowCommand}" />
                                    <Button Content="Clear Flow" Command="{Binding ClearMaterialFlowCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding InspectorMaterialFlowText}" Foreground="#D8DEE9" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    IsVisible="{Binding ExpertInspectorVisible}"
                    Margin="8"
                    Padding="10"
                    Background="#232833"
                    CornerRadius="4">
                <StackPanel Spacing="8">
                    <TextBlock Text="Inspector" FontWeight="Bold" Foreground="#ECEFF4" FontSize="14" />
                    <TextBlock Text="{Binding InspectorSelectedText}" Foreground="#D8DEE9" />
                    <Grid ColumnDefinitions="52,*" ColumnSpacing="8">
                        <TextBlock Grid.Column="0"
                                   Text="Name"
                                   VerticalAlignment="Center"
                                   Foreground="#AFC6E9" />
                        <TextBox Grid.Column="1"
                                 IsEnabled="{Binding HasSelectedObject}"
                                 Text="{Binding SelectedObjectName, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Text="{Binding InspectorIdText}" Foreground="#D8DEE9" />
                    <TextBlock Text="{Binding InspectorPositionText}" Foreground="#D8DEE9" />
                    <TextBlock Text="{Binding InspectorSizeText}" Foreground="#D8DEE9" />
                    <TextBlock Text="{Binding InspectorRotationText}" Foreground="#D8DEE9" />
                    <TextBlock Text="{Binding InspectorStatusText}" Foreground="#D8DEE9" />
                    <TextBlock Text="{Binding InspectorContextText}" Foreground="#D8DEE9" />
                    <TextBlock Text="{Binding InspectorRangeText}" Foreground="#D8DEE9" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding InspectorExtraText}" Foreground="#D8DEE9" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding InspectorPortText}" Foreground="#D8DEE9" TextWrapping="Wrap" />

                    <Border IsVisible="{Binding SelectedMtrlSrcPanelVisible}"
                            Background="#1C212A"
                            BorderBrush="#6C8F59"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8">
                        <StackPanel Spacing="8">
                            <TextBlock Text="MtrlSrc Settings" FontWeight="SemiBold" Foreground="#ECEFF4" />
                            <TextBlock Text="Choose how many units/second this source produces when connected to a conveyor route."
                                       Foreground="#C8D2DE"
                                       TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="92,*" RowDefinitions="Auto" ColumnSpacing="6">
                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Text="Material"
                                           Foreground="#AFC6E9" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableMtrlSrcMaterialIds}"
                                          SelectedItem="{Binding SelectedMtrlSrcMaterialId, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnDefinitions="92,*" RowDefinitions="Auto" ColumnSpacing="6">
                               <TextBlock Grid.Column="0"
                                          VerticalAlignment="Center"
                                          Text="Granules"
                                          Foreground="#AFC6E9" />
                               <ComboBox Grid.Column="1"
                                         ItemsSource="{Binding AvailableMtrlSrcGranuleCounts}"
                                         SelectedItem="{Binding SelectedMtrlSrcGranulesPerPacket, Mode=TwoWay}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="-0.5" Command="{Binding DecreaseSelectedMtrlSrcRateCommand}" />
                                <TextBox Width="92"
                                         Text="{Binding SelectedMtrlSrcUnitsPerSecondText, Mode=TwoWay}" />
                                <Button Content="+0.5" Command="{Binding IncreaseSelectedMtrlSrcRateCommand}" />
                                <Button Content="Apply" Command="{Binding ApplySelectedMtrlSrcRateCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedMtrlSrcRateStatusText}" Foreground="#A7D397" />
                        </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding ConveyorRoutePanelVisible}"
                            Background="#1C212A"
                            BorderBrush="#3B4252"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Conveyor Route" FontWeight="SemiBold" Foreground="#ECEFF4" />
                            <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Anchors" Foreground="#AFC6E9" FontFamily="Consolas" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ConveyorRouteAnchorsValue}" Foreground="#D8DEE9" FontFamily="Consolas" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Z Layer" Foreground="#AFC6E9" FontFamily="Consolas" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConveyorRouteZValue}" Foreground="#D8DEE9" FontFamily="Consolas" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Preview" Foreground="#AFC6E9" FontFamily="Consolas" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ConveyorRoutePreviewValue}" Foreground="#D8DEE9" FontFamily="Consolas" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Block Reason" Foreground="#AFC6E9" FontFamily="Consolas" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ConveyorRouteBlockedReasonValue}" Foreground="#D8DEE9" TextWrapping="Wrap" FontFamily="Consolas" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Separator Margin="0,6,0,6" />
                    <TextBlock Text="Floor / Layer" FontWeight="SemiBold" Foreground="#ECEFF4" />
                    <Border Background="{Binding Floor2StackBackground}" BorderBrush="{Binding Floor2StackBorder}" BorderThickness="1" CornerRadius="4" Padding="6,4">
                        <Button Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Command="{Binding Floor2Command}">
                            <TextBlock Text="{Binding Floor2StackText}" Foreground="#D8DEE9" />
                        </Button>
                    </Border>
                    <Border Background="{Binding Floor1StackBackground}" BorderBrush="{Binding Floor1StackBorder}" BorderThickness="1" CornerRadius="4" Padding="6,4">
                        <Button Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Command="{Binding Floor1Command}">
                            <TextBlock Text="{Binding Floor1StackText}" Foreground="#D8DEE9" />
                        </Button>
                    </Border>
                    <Border Background="{Binding Floor0StackBackground}" BorderBrush="{Binding Floor0StackBorder}" BorderThickness="1" CornerRadius="4" Padding="6,4">
                        <Button Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Command="{Binding Floor0Command}">
                            <TextBlock Text="{Binding Floor0StackText}" Foreground="#D8DEE9" />
                        </Button>
                    </Border>
                    <TextBlock Text="{Binding ActiveFloorSummaryText}" Foreground="#D8DEE9" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding ActiveLayerSummaryText}" Foreground="#D8DEE9" />
                    <TextBlock Text="{Binding ActiveAbsoluteZSummaryText}" Foreground="#D8DEE9" />
                    <TextBlock IsVisible="{Binding ExpertGpuLabelsVisible}" Text="{Binding PreferredOpenGlGpuSummaryText}" Foreground="#AFC6E9" TextWrapping="Wrap" />
                    <TextBlock IsVisible="{Binding ExpertGpuLabelsVisible}" Text="{Binding OpenGlBackendSummaryText}" Foreground="#AFC6E9" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
