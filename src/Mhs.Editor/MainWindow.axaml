<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Mhs.Editor.ViewModels"
        xmlns:viewport="clr-namespace:Mhs.Editor.Viewport"
        mc:Ignorable="d"
        x:DataType="vm:MainWindowViewModel"
        d:DesignWidth="1600"
        d:DesignHeight="950"
        x:Class="Mhs.Editor.MainWindow"
        Title="MHS Editor PoC"
        Width="1600"
        Height="950"
        MinWidth="900"
        MinHeight="600">
    <Window.Styles>
        <Style Selector="Button.catalog-tool">
            <Setter Property="Background" Value="#2A3038" />
            <Setter Property="Foreground" Value="#D9DEE5" />
            <Setter Property="BorderBrush" Value="#404853" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="10.5" />
        </Style>
        <Style Selector="Button.part-tile">
            <Setter Property="Width" Value="88" />
            <Setter Property="Height" Value="94" />
            <Setter Property="Background" Value="#1A2028" />
            <Setter Property="BorderBrush" Value="#2E3946" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.part-tile:pointerover">
            <Setter Property="Background" Value="#273648" />
            <Setter Property="BorderBrush" Value="#78AFFF" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.part-tile:pressed">
            <Setter Property="Background" Value="#1F4F83" />
            <Setter Property="BorderBrush" Value="#9CCDFF" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.part-tile:focus">
            <Setter Property="BorderBrush" Value="#FFD15A" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.part-tile.accent">
            <Setter Property="Background" Value="#214A76" />
            <Setter Property="BorderBrush" Value="#8FC6FF" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.ribbon-button">
            <Setter Property="Background" Value="#222831" />
            <Setter Property="Foreground" Value="#E6ECF4" />
            <Setter Property="BorderBrush" Value="#323C48" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="Button.ribbon-button:pointerover">
            <Setter Property="Background" Value="#2D3744" />
            <Setter Property="BorderBrush" Value="#4F6F96" />
        </Style>
        <Style Selector="Button.ribbon-button.accent">
            <Setter Property="Background" Value="#274C7A" />
            <Setter Property="BorderBrush" Value="#5CA8FF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.ribbon-button:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="Button.ribbon-icon">
            <Setter Property="Background" Value="#1B2129" />
            <Setter Property="Foreground" Value="#DDE7F3" />
            <Setter Property="BorderBrush" Value="#303946" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="MinWidth" Value="42" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="TextBlock.ribbon-label">
            <Setter Property="Foreground" Value="#7E8EA2" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.ribbon-group">
            <Setter Property="BorderBrush" Value="#313946" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Padding" Value="8,0" />
        </Style>

    </Window.Styles>
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="#171C22"
                BorderBrush="#2D343F"
                BorderThickness="0,0,0,1">
            <Grid RowDefinitions="48,54">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Background="#151A20">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" Margin="10,0" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="6" Background="#213247" BorderBrush="#3F6C99" BorderThickness="1">
                            <TextBlock Text="M" Foreground="#FFD15A" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="Material Handling System Editor" Foreground="#F0F4FA" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Command Workspace" Foreground="#738398" FontSize="10" />
                        </StackPanel>
                    </StackPanel>

                    <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Classes="ribbon-group">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Classes="ribbon-button" Content="New" Click="OnNewSceneClick" />
                                <Button Classes="ribbon-button" Content="Open" Click="OnOpenSceneClick" />
                                <Button Classes="ribbon-button" Content="Save" Click="OnSaveSceneClick" />
                                <Button Classes="ribbon-button" Content="Save As" Click="OnSaveSceneAsClick" />
                            </StackPanel>
                        </Border>
                        <Border Classes="ribbon-group">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Classes="ribbon-button" Content="Undo" Command="{Binding UndoCommand}" />
                                <Button Classes="ribbon-button" Content="Redo" Command="{Binding RedoCommand}" />
                            </StackPanel>
                        </Border>
                        <Border Classes="ribbon-group">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Classes="ribbon-button accent" Content="▶ Test (F5)" Command="{Binding RunTestCommand}" />
                                <Button Classes="ribbon-button" Content="Demo Factory" Command="{Binding LoadDemoFactorySceneCommand}" ToolTip.Tip="Load a representative material-handling demo scene" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="10,0" VerticalAlignment="Center">
                        <Menu Background="Transparent" Foreground="#DDE7F3">
                            <MenuItem Header="☰">
                                <MenuItem Header="_Demo Factory Scene" Command="{Binding LoadDemoFactorySceneCommand}" />
                                <Separator />
                                <MenuItem Header="_Settings">
                                    <MenuItem Header="_Application Settings..." Click="OnSettingsClick" />
                                    <Separator />
                                    <MenuItem Header="I want _Blender like settings"
                                              IsChecked="{Binding IsBlenderLikeSettingsActive}"
                                              Command="{Binding BlenderLikeSettingsCommand}" />
                                    <MenuItem Header="I want _AutoCAD like settings"
                                              IsChecked="{Binding IsAutoCadLikeSettingsActive}"
                                              Command="{Binding AutoCadLikeSettingsCommand}" />
                                    <Separator />
                                    <MenuItem Header="OpenGL _GPU Setup..." Click="OnOpenGlGpuSetupClick" />
                                    <Separator />
                                    <MenuItem Header="Use _Software Renderer"
                                              IsChecked="{Binding IsSoftwareViewportMode}"
                                              Command="{Binding UseSoftwareViewportCommand}" />
                                    <MenuItem Header="Use _OpenGL Renderer"
                                              IsChecked="{Binding IsOpenGlViewportMode}"
                                              Command="{Binding UseOpenGlViewportCommand}" />
                                    <Separator />
                                    <MenuItem Header="Show Conveyor _Debug"
                                              IsChecked="{Binding ShowConveyorDebug, Mode=TwoWay}" />
                                </MenuItem>
                                <MenuItem Header="E_xit" Click="OnExitClick" />
                            </MenuItem>
                        </Menu>
                        <Button Classes="ribbon-icon" Click="OnSettingsClick" ToolTip.Tip="Settings">
                            <TextBlock Text="⚙" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" Background="#20262E">
                    <Border Grid.Column="0" Classes="ribbon-group">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Classes="ribbon-button" Classes.accent="{Binding IsSelectActive}" Content="Select" Command="{Binding SelectToolCommand}" />
                            <Button Classes="ribbon-button" Classes.accent="{Binding IsMoveActionActive}" Content="Move" Command="{Binding MoveSelectionCommand}" />
                            <Button Classes="ribbon-button" Classes.accent="{Binding IsRotateActionActive}" Content="Rotate" Command="{Binding RotateSelectionCommand}" />
                            <Button Classes="ribbon-button" Content="Delete" Command="{Binding DeleteSelectionCommand}" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,0" VerticalAlignment="Center">
                            <Button Classes="ribbon-button" Classes.accent="{Binding IsConveyorRouteActive}" Content="Conveyor" Command="{Binding ConveyorRouteToolCommand}" />
                            <Button Classes="ribbon-button" Classes.accent="{Binding IsHopperActive}" Content="Hopper" Command="{Binding HopperToolCommand}" />
                            <Button Classes="ribbon-button" Classes.accent="{Binding IsChuteActive}" Content="Chute" Command="{Binding ChuteToolCommand}" />
                            <Button Classes="ribbon-button" Classes.accent="{Binding IsBinActive}" Content="Bin" Command="{Binding BinToolCommand}" />
                            <Button Classes="ribbon-button" Classes.accent="{Binding IsSplitterActive}" Content="Splitter" Command="{Binding SplitterToolCommand}" />
                            <Button Classes="ribbon-button" Classes.accent="{Binding IsLiftActive}" Content="Lift" Command="{Binding LiftToolCommand}" />
                            <Button Classes="ribbon-button" Classes.accent="{Binding IsTurnActive}" Content="Turn" Command="{Binding TurnToolCommand}" />
                            <Button Classes="ribbon-button" Classes.accent="{Binding IsMergeActive}" Content="Merge" Command="{Binding MergeToolCommand}" />
                            <Button Classes="ribbon-button" Classes.accent="{Binding IsSupportActive}" Content="Support" Command="{Binding SupportToolCommand}" />
                            <Button Classes="ribbon-button" Content="Other" Command="{Binding OtherPartsCommand}" />
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Column="2" Classes="ribbon-group">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Classes="ribbon-button" Classes.accent="{Binding IsIsoViewActive}" Content="Iso" Command="{Binding IsoViewCommand}" />
                            <Button Classes="ribbon-button" Classes.accent="{Binding IsTopViewActive}" Content="Top" Command="{Binding TopViewCommand}" />
                            <Button Classes="ribbon-button" Classes.accent="{Binding IsFrontViewActive}" Content="Front" Command="{Binding FrontViewCommand}" />
                            <Button Classes="ribbon-button" Classes.accent="{Binding IsRightViewActive}" Content="Right" Command="{Binding RightViewCommand}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" Margin="8,0,10,0" VerticalAlignment="Center">
                        <TextBlock Classes="ribbon-label" Text="Snap" VerticalAlignment="Center" />
                        <Border Background="#151A20" BorderBrush="#354152" BorderThickness="1" CornerRadius="4" Padding="12,7" MinWidth="92">
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="Grid" Foreground="#E4ECF6" />
                                <TextBlock DockPanel.Dock="Right" Text="⌄" Foreground="#8DA0B7" Margin="12,0,0,0" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#151A20" BorderBrush="#303844" BorderThickness="0,1,0,0" Padding="10,3">
            <TextBlock Foreground="#C9D3DF"
                       FontSize="11"
                       Text="{Binding StatusText}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <Grid ColumnDefinitions="280,*,300" Background="#1B1D23">
            <DockPanel Grid.Column="0" Margin="8" LastChildFill="True">
                <Border DockPanel.Dock="Top" Padding="10" Background="#20252C" CornerRadius="4" Margin="0,0,0,6">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Material Handling" FontWeight="SemiBold" Foreground="#ECEFF4" FontSize="13" />
                        <TextBox PlaceholderText="Search parts..."
                                 Text="{Binding PartSearchText, Mode=TwoWay}"
                                 Background="#131922"
                                 BorderBrush="#3B4C61"
                                 Foreground="#E5E9F0" />
                        <ScrollViewer MaxHeight="620" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding PartCatalogSections}" HorizontalAlignment="Stretch">
                                <ItemsControl.Styles>
                                    <Style Selector="ContentPresenter">
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    </Style>
                                </ItemsControl.Styles>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PartCatalogSectionViewModel">
                                        <StackPanel Spacing="5" Margin="0,8,0,0" HorizontalAlignment="Stretch">
                                            <Border Background="#18212B"
                                                    BorderBrush="#2E3B49"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="0,0,0,4">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="#9EACBA"
                                                           FontSize="10"
                                                           FontWeight="Bold" />
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Items}" HorizontalAlignment="Stretch">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.Styles>
                                                    <Style Selector="ContentPresenter">
                                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                                    </Style>
                                                </ItemsControl.Styles>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PartCatalogItemViewModel">
                                                        <Button Classes="part-tile" Command="{Binding ActivateCommand}">
                                                            <StackPanel Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Stretch">
                                                                <Border Width="54"
                                                                        Height="52"
                                                                        Background="#10161D"
                                                                        BorderBrush="#33404D"
                                                                        BorderThickness="1"
                                                                        CornerRadius="6"
                                                                        HorizontalAlignment="Center">
                                                                    <Image Source="{Binding ThumbnailImage}"
                                                                           Width="46"
                                                                           Height="46"
                                                                           Stretch="Uniform"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                                </Border>
                                                                <TextBlock Text="{Binding DisplayName}"
                                                                           Foreground="#DEE6F0"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           TextAlignment="Center"
                                                                           TextWrapping="Wrap"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxLines="2"
                                                                           HorizontalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button Content="Browse More Parts..."
                                Command="{Binding BrowseMorePartsCommand}"
                                Background="#233A5A"
                                Foreground="#E8F1FC"
                                BorderBrush="#4A6F9F"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,6" />
                    </StackPanel>
                </Border>

                <Border Padding="8" Background="#1A1F29" CornerRadius="4">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Scene Objects"
                                   FontWeight="Bold"
                                   Foreground="#ECEFF4"
                                   FontSize="13"
                                   Margin="0,0,0,6" />
                        <ScrollViewer>
                            <ListBox x:Name="SceneTreeListBox"
                                     ItemsSource="{Binding SceneTreeNodes}"
                                     SelectedItem="{Binding SelectedSceneTreeNode, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     SelectionChanged="OnSceneTreeSelectionChanged"
                                     DoubleTapped="OnSceneTreeDoubleTapped">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="4,3" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="Margin" Value="0,1" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="1" />
                                    </Style>
                                    <Style Selector="ListBoxItem:selected">
                                        <Setter Property="Background" Value="#2B3E58" />
                                        <Setter Property="BorderBrush" Value="#88B8FF" />
                                    </Style>
                                    <Style Selector="ListBoxItem:pointerover:not(:selected)">
                                        <Setter Property="Background" Value="#1F2934" />
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SceneTreeNodeViewModel">
                                        <Panel>
                                            <TextBlock Text="{Binding Label}"
                                                       IsVisible="{Binding IsGroupHeader}"
                                                       Foreground="#5E7A94"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Margin="{Binding ContentMargin}" />
                                            <StackPanel IsVisible="{Binding !IsGroupHeader}" Spacing="1" Margin="{Binding ContentMargin}">
                                                <TextBlock Text="{Binding Label}"
                                                           Foreground="#C8D8E8"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding StatusText}"
                                                           IsVisible="{Binding HasStatus}"
                                                           Foreground="#6FADB5"
                                                           FontSize="10"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Panel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </DockPanel>

            <Border Grid.Column="1"
                    Grid.ColumnSpan="{Binding SceneViewportColumnSpan}"
                    Margin="8"
                    Background="{Binding ViewportPanelBackground}"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{Binding ViewportPanelBorderBrush}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#242830" BorderBrush="{Binding ViewportPanelBorderBrush}" BorderThickness="0,0,0,1" Padding="10,7">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="Factory View"
                                       Foreground="#EEF4FB"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding ViewportSummaryText}"
                                       Foreground="#8EA2BA"
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Grid Background="{Binding ViewportSurfaceBackground}">
                    <viewport:SoftwareCubeViewport x:Name="SoftwareViewport"
                                                   IsVisible="{Binding IsSoftwareViewportMode}"
                                                   EditorState="{Binding EditorState}"
                                                       InteractionPreset="{Binding InteractionPreset}" />
                    <viewport:OpenGlViewportControl x:Name="OpenGlViewport"
                                                       IsVisible="{Binding IsOpenGlViewportMode}"
                                                        EditorState="{Binding EditorState}"
                                                        InteractionPreset="{Binding InteractionPreset}" />

                        <Border HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,18"
                                Padding="12,9"
                                Background="{Binding ViewportToolbarBackground}"
                                BorderBrush="{Binding ViewportToolbarBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                BoxShadow="0 8 24 0 #80000000">
                            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <TextBlock Text="Floor" Foreground="{Binding ViewportToolbarTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <RadioButton Content="0" Foreground="{Binding ViewportToolbarControlBrush}" GroupName="FloorSelect" IsChecked="{Binding IsFloor0Active}" Command="{Binding Floor0Command}" />
                                    <RadioButton Content="1" Foreground="{Binding ViewportToolbarControlBrush}" GroupName="FloorSelect" IsChecked="{Binding IsFloor1Active}" Command="{Binding Floor1Command}" />
                                    <RadioButton Content="2" Foreground="{Binding ViewportToolbarControlBrush}" GroupName="FloorSelect" IsChecked="{Binding IsFloor2Active}" Command="{Binding Floor2Command}" />
                                </StackPanel>
                                <Border Width="1" Background="{Binding ViewportToolbarSeparatorBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LayerDisplayText}" Foreground="{Binding ViewportToolbarTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <RadioButton Content="0" Foreground="{Binding ViewportToolbarControlBrush}" GroupName="LayerSelect" IsChecked="{Binding IsLayer0Active}" Command="{Binding Layer0Command}" />
                                    <RadioButton Content="1" Foreground="{Binding ViewportToolbarControlBrush}" GroupName="LayerSelect" IsChecked="{Binding IsLayer1Active}" Command="{Binding Layer1Command}" />
                                    <RadioButton Content="2" Foreground="{Binding ViewportToolbarControlBrush}" GroupName="LayerSelect" IsChecked="{Binding IsLayer2Active}" Command="{Binding Layer2Command}" />
                                </StackPanel>
                                <Border Width="1" Background="{Binding ViewportToolbarSeparatorBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <TextBlock Text="Style" Foreground="{Binding ViewportToolbarTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <RadioButton Content="Presentation" Foreground="{Binding ViewportToolbarControlBrush}" GroupName="ViewportVisualMode" IsChecked="{Binding IsPresentationViewportVisualMode}" Command="{Binding UsePresentationViewportModeCommand}" />
                                    <RadioButton Content="Technical" Foreground="{Binding ViewportToolbarControlBrush}" GroupName="ViewportVisualMode" IsChecked="{Binding IsTechnicalViewportVisualMode}" Command="{Binding UseTechnicalViewportModeCommand}" />
                                </StackPanel>
                                <Border Width="1" Background="{Binding ViewportToolbarSeparatorBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <CheckBox Content="Show Grid" IsChecked="{Binding ShowGrid, Mode=TwoWay}" Foreground="{Binding ViewportToolbarControlBrush}" />
                                    <CheckBox Content="Show Bounds" IsChecked="{Binding ShowBounds, Mode=TwoWay}" Foreground="{Binding ViewportToolbarControlBrush}" />
                                    <CheckBox Content="Show Flow" IsChecked="{Binding ShowFlow, Mode=TwoWay}" Foreground="{Binding ViewportToolbarControlBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding AbsoluteZDisplayText}" Foreground="{Binding ViewportToolbarSubtleTextBrush}" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border IsVisible="{Binding FloatingDebugPanelVisible}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="14"
                                MaxWidth="380"
                                Padding="12"
                                Background="#D9131820"
                                BorderBrush="#586A82"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Conveyor Debug" FontWeight="Bold" Foreground="#F3F6FB" />
                                <TextBlock Text="{Binding ConveyorDebugSelectionText}" Foreground="#D8DEE9" />
                                <TextBlock Text="{Binding ConveyorDebugRouteSummaryText}" Foreground="#BFD2EA" TextWrapping="Wrap" />
                                <Border Background="#0F1217"
                                        BorderBrush="#374657"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8">
                                    <TextBlock Text="{Binding ConveyorDebugGridText}"
                                               Foreground="#E5E9F0"
                                               FontFamily="Consolas"
                                               TextWrapping="NoWrap" />
                                </Border>
                                <TextBlock Text="{Binding ConveyorDebugLegendText}" Foreground="#8EACCC" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="Inject DebugOre" Command="{Binding InjectDebugOreCommand}" />
                                    <Button Content="Step Flow" Command="{Binding StepMaterialFlowCommand}" />
                                    <Button Content="Clear Flow" Command="{Binding ClearMaterialFlowCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding InspectorMaterialFlowText}" Foreground="#D8DEE9" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    IsVisible="{Binding ExpertInspectorVisible}"
                    Margin="8"
                    Padding="0"
                    Background="#232833"
                    CornerRadius="4">
                <TabControl>
                    <TabItem Header="Inspector">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="10" Margin="10">
                                <Grid ColumnDefinitions="86,*" ColumnSpacing="10">
                                    <Border Grid.Column="0"
                                            Width="78"
                                            Height="78"
                                            Background="#111820"
                                            BorderBrush="#3B4C61"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="8">
                                        <Grid>
                                            <Image Source="{Binding SelectedObjectThumbnailImage}"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                            <TextBlock Text="PART"
                                                       Foreground="#465569"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Bottom" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding InspectorSelectedText}"
                                                   Foreground="#EEF4FB"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <Grid ColumnDefinitions="52,*" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0"
                                                       Text="Name"
                                                       VerticalAlignment="Center"
                                                       Foreground="#AFC6E9" />
                                            <TextBox x:Name="InspectorNameTextBox"
                                                     Grid.Column="1"
                                                     IsEnabled="{Binding HasSelectedObject}"
                                                     Text="{Binding SelectedObjectName, Mode=TwoWay}"
                                                     GotFocus="OnInspectorNameGotFocus"
                                                     KeyDown="OnInspectorNameKeyDown" />
                                        </Grid>
                                        <Border Background="#13251C"
                                                BorderBrush="{Binding InspectorValidityBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="8,4"
                                                HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="8" Height="8" Fill="{Binding InspectorValidityBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding InspectorValidityText}"
                                                           Foreground="{Binding InspectorValidityBrush}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding InspectorValidityDetail}"
                                                           Foreground="#B8C7D9"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <Border Background="#1C212A"
                                        BorderBrush="#3B4252"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8">
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="TRANSFORM"
                                                   Foreground="#8EA2BA"
                                                   FontSize="10"
                                                   FontWeight="Bold" />
                                        <Grid ColumnDefinitions="82,*,*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Position" Foreground="#AFC6E9" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="0" Grid.Column="1" Watermark="X" IsEnabled="{Binding HasSelectedObject}" Text="{Binding InspectorPositionX, Mode=TwoWay}" />
                                            <TextBox Grid.Row="0" Grid.Column="2" Watermark="Y" IsEnabled="{Binding HasSelectedObject}" Text="{Binding InspectorPositionY, Mode=TwoWay}" />
                                            <TextBox Grid.Row="0" Grid.Column="3" Watermark="Z" IsEnabled="{Binding HasSelectedObject}" Text="{Binding InspectorPositionZ, Mode=TwoWay}" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Rotation" Foreground="#AFC6E9" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="1" Grid.Column="1" IsEnabled="{Binding HasSelectedObject}" Text="{Binding InspectorRotationZDegrees, Mode=TwoWay}" />
                                            <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Text="degrees around Z" Foreground="#8EA2BA" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Base" Foreground="#AFC6E9" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding InspectorBaseSizeValue}" Foreground="#D8DEE9" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Effective" Foreground="#AFC6E9" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding InspectorEffectiveSizeValue}" Foreground="#D8DEE9" TextWrapping="Wrap" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="#1C212A"
                                        BorderBrush="#3B4252"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8">
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="CONVEYOR"
                                                   Foreground="#8EA2BA"
                                                   FontSize="10"
                                                   FontWeight="Bold" />
                                        <Grid ColumnDefinitions="82,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Length" Foreground="#AFC6E9" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InspectorConveyorLengthText}" Foreground="#D8DEE9" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Range" Foreground="#AFC6E9" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InspectorConveyorRangeText}" Foreground="#D8DEE9" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Speed" Foreground="#AFC6E9" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="2" Grid.Column="1" IsEnabled="{Binding SelectedMtrlSrcPanelVisible}" Text="{Binding SelectedMtrlSrcUnitsPerSecondText, Mode=TwoWay}" />
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Direction" Foreground="#AFC6E9" />
                                            <CheckBox Grid.Row="3" Grid.Column="1" IsEnabled="{Binding InspectorConveyorDirectionEditable}" IsChecked="{Binding InspectorConveyorFlowReversed, Mode=TwoWay}" Content="Reverse conveyor flow" Foreground="#D8DEE9" />
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Transfer" Foreground="#AFC6E9" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding InspectorTransferBehaviorText}" Foreground="#D8DEE9" TextWrapping="Wrap" />
                                        </Grid>

                                        <Border IsVisible="{Binding SelectedMtrlSrcPanelVisible}"
                                                Background="#172217"
                                                BorderBrush="#6C8F59"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="MATERIAL SOURCE"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="#A7D397" />
                                                <TextBlock Text="Edit material and packet settings. Speed is shared with the conveyor Speed field above."
                                                           Foreground="#C8D2DE"
                                                           TextWrapping="Wrap" />
                                                <Grid ColumnDefinitions="80,*" RowDefinitions="Auto" ColumnSpacing="6">
                                                    <TextBlock Grid.Column="0"
                                                               VerticalAlignment="Center"
                                                               Text="Material"
                                                               Foreground="#AFC6E9" />
                                                    <ComboBox Grid.Column="1"
                                                              ItemsSource="{Binding AvailableMtrlSrcMaterialIds}"
                                                              SelectedItem="{Binding SelectedMtrlSrcMaterialId, Mode=TwoWay}" />
                                                </Grid>
                                                <Grid ColumnDefinitions="80,*" RowDefinitions="Auto" ColumnSpacing="6">
                                                   <TextBlock Grid.Column="0"
                                                              VerticalAlignment="Center"
                                                              Text="Granules"
                                                              Foreground="#AFC6E9" />
                                                   <ComboBox Grid.Column="1"
                                                             ItemsSource="{Binding AvailableMtrlSrcGranuleCounts}"
                                                             SelectedItem="{Binding SelectedMtrlSrcGranulesPerPacket, Mode=TwoWay}" />
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                                                    <Button Grid.Column="0" Content="-0.5" Command="{Binding DecreaseSelectedMtrlSrcRateCommand}" />
                                                    <TextBox Grid.Column="1"
                                                             MinWidth="68"
                                                             Text="{Binding SelectedMtrlSrcUnitsPerSecondText, Mode=TwoWay}" />
                                                    <Button Grid.Column="2" Content="+0.5" Command="{Binding IncreaseSelectedMtrlSrcRateCommand}" />
                                                    <Button Grid.Column="3" Content="Apply" Command="{Binding ApplySelectedMtrlSrcRateCommand}" />
                                                </Grid>
                                                <TextBlock Text="{Binding SelectedMtrlSrcRateStatusText}" Foreground="#A7D397" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <Border IsVisible="{Binding ConveyorRoutePanelVisible}"
                                                Background="#151B23"
                                                BorderBrush="#3B4252"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="ROUTE PREVIEW" FontSize="10" FontWeight="Bold" Foreground="#8EA2BA" />
                                                <Grid ColumnDefinitions="88,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="4">
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Anchors" Foreground="#AFC6E9" />
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ConveyorRouteAnchorsValue}" Foreground="#D8DEE9" FontFamily="Consolas" />
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Z Layer" Foreground="#AFC6E9" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConveyorRouteZValue}" Foreground="#D8DEE9" FontFamily="Consolas" />
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Preview" Foreground="#AFC6E9" />
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ConveyorRoutePreviewValue}" Foreground="#D8DEE9" FontFamily="Consolas" />
                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Block" Foreground="#AFC6E9" />
                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ConveyorRouteBlockedReasonValue}" Foreground="#D8DEE9" TextWrapping="Wrap" FontFamily="Consolas" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Background="#1C212A"
                                        BorderBrush="#3B4252"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8">
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="VISUAL"
                                                   Foreground="#8EA2BA"
                                                   FontSize="10"
                                                   FontWeight="Bold" />
                                        <Grid ColumnDefinitions="82,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Material" Foreground="#AFC6E9" VerticalAlignment="Center" />
                                            <ComboBox Grid.Row="0" Grid.Column="1" IsEnabled="{Binding SelectedMtrlSrcPanelVisible}" ItemsSource="{Binding AvailableMtrlSrcMaterialIds}" SelectedItem="{Binding SelectedMtrlSrcMaterialId, Mode=TwoWay}" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Paint" Foreground="#AFC6E9" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="1" Grid.Column="1" IsEnabled="False" Text="{Binding InspectorPaintText}" />
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Accent" Foreground="#AFC6E9" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="2" Grid.Column="1" IsEnabled="False" Text="{Binding InspectorAccentColorText}" />
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Type" Foreground="#AFC6E9" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding InspectorPartTypeText}" Foreground="#D8DEE9" TextWrapping="Wrap" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Expander Header="Advanced diagnostics" IsExpanded="False">
                                    <Border Background="#151B23"
                                            BorderBrush="#3B4252"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{Binding InspectorIdText}" Foreground="#D8DEE9" />
                                            <TextBlock Text="{Binding InspectorDiagnosticPositionText}" Foreground="#D8DEE9" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding InspectorDiagnosticSizeText}" Foreground="#D8DEE9" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding InspectorDiagnosticEffectiveSizeText}" Foreground="#D8DEE9" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding InspectorDiagnosticRotationText}" Foreground="#D8DEE9" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding InspectorDiagnosticZSpanText}" Foreground="#D8DEE9" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding InspectorDiagnosticRangeText}" Foreground="#D8DEE9" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding InspectorDiagnosticExtraText}" Foreground="#D8DEE9" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding InspectorPortText}" Foreground="#D8DEE9" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding InspectorMaterialFlowText}" Foreground="#D8DEE9" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Scene">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="8" Margin="10">
                                <TextBlock Text="FLOOR / LAYER"
                                           Foreground="#8EA2BA"
                                           FontSize="10"
                                           FontWeight="Bold" />
                                <Border Background="{Binding Floor2StackBackground}" BorderBrush="{Binding Floor2StackBorder}" BorderThickness="1" CornerRadius="4" Padding="6,4">
                                    <Button Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Command="{Binding Floor2Command}">
                                        <TextBlock Text="{Binding Floor2StackText}" Foreground="#D8DEE9" />
                                    </Button>
                                </Border>
                                <Border Background="{Binding Floor1StackBackground}" BorderBrush="{Binding Floor1StackBorder}" BorderThickness="1" CornerRadius="4" Padding="6,4">
                                    <Button Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Command="{Binding Floor1Command}">
                                        <TextBlock Text="{Binding Floor1StackText}" Foreground="#D8DEE9" />
                                    </Button>
                                </Border>
                                <Border Background="{Binding Floor0StackBackground}" BorderBrush="{Binding Floor0StackBorder}" BorderThickness="1" CornerRadius="4" Padding="6,4">
                                    <Button Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Command="{Binding Floor0Command}">
                                        <TextBlock Text="{Binding Floor0StackText}" Foreground="#D8DEE9" />
                                    </Button>
                                </Border>
                                <Grid ColumnDefinitions="94,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="5" Margin="0,6,0,0">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Active floor" Foreground="#AFC6E9" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ActiveFloorSummaryText}" Foreground="#D8DEE9" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Active layer" Foreground="#AFC6E9" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ActiveLayerSummaryText}" Foreground="#D8DEE9" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Absolute Z" Foreground="#AFC6E9" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ActiveAbsoluteZSummaryText}" Foreground="#D8DEE9" TextWrapping="Wrap" />
                                </Grid>
                                <Expander Header="Advanced renderer diagnostics"
                                          IsExpanded="False"
                                          IsVisible="{Binding ExpertGpuLabelsVisible}">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Renderer" Foreground="#AFC6E9" FontSize="11" VerticalAlignment="Center" />
                                            <RadioButton Content="Software" GroupName="RendererMode" IsChecked="{Binding IsSoftwareViewportMode}" Command="{Binding UseSoftwareViewportCommand}" />
                                            <RadioButton Content="OpenGL" GroupName="RendererMode" IsChecked="{Binding IsOpenGlViewportMode}" Command="{Binding UseOpenGlViewportCommand}" />
                                        </StackPanel>
                                        <CheckBox Content="Show Conveyor Debug"
                                                  IsChecked="{Binding ShowConveyorDebug, Mode=TwoWay}"
                                                  Foreground="#C7D1DD" />
                                        <TextBlock Text="{Binding PreferredOpenGlGpuSummaryText}" Foreground="#AFC6E9" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding OpenGlBackendSummaryText}" Foreground="#AFC6E9" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </DockPanel>
</Window>
