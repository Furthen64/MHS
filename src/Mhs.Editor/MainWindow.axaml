<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Mhs.Editor.ViewModels"
        xmlns:viewport="clr-namespace:Mhs.Editor.Viewport"
        mc:Ignorable="d"
        x:DataType="vm:MainWindowViewModel"
        d:DesignWidth="1600"
        d:DesignHeight="950"
        x:Class="Mhs.Editor.MainWindow"
        Title="MHS Editor PoC"
        Width="1600"
        Height="950"
        MinWidth="900"
        MinHeight="600">
    <Window.Styles>
        <Style Selector="Button.catalog-tool">
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_2A3038}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_D9DEE5}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_404853}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="10.5" />
        </Style>
        <Style Selector="Button.part-tile">
            <Setter Property="Width" Value="116" />
            <Setter Property="Height" Value="132" />
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_202A36}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_3F5368}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.part-tile:pointerover">
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_2B3E52}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_89C4FF}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.part-tile:pressed">
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_1F4F83}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_9CCDFF}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.part-tile:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_FFD15A}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.part-tile.accent">
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_214A76}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_8FC6FF}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.catalog-filter">
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_18212B}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_B9C6D4}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_334557}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style Selector="Button.catalog-filter.selected">
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_335C8A}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_FFFFFF}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_8FC6FF}" />
        </Style>
        <Style Selector="Button.ribbon-button">
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_202834}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_E6ECF4}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_354352}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="MinWidth" Value="60" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.ribbon-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_2A3A4D}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_6BA9FF}" />
        </Style>
        <Style Selector="Button.ribbon-button.accent">
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_1D5D97}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_8BC7FF}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_FFFFFF}" />
        </Style>
        <Style Selector="Button.ribbon-button.accent:pointerover">
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_2472B8}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_B5DDFF}" />
        </Style>
        <Style Selector="Button.ribbon-button:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_FFD15A}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.ribbon-button:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="Button.ribbon-icon">
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_1B2129}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_DDE7F3}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_303946}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="MinWidth" Value="42" />
            <Setter Property="MinHeight" Value="38" />
        </Style>
        <Style Selector="TextBlock.toolbar-icon">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="LineHeight" Value="18" />
        </Style>
        <Style Selector="TextBlock.toolbar-label">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.ribbon-label">
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_9AAABD}" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="0.4" />
        </Style>
        <Style Selector="Border.ribbon-group">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_35404D}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
        <Style Selector="Border.active-tool-pill">
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_243750}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_69B6FF}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style Selector="Border.workflow-card">
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_26313B}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_445468}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
        <Style Selector="TextBlock.workflow-label">
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_9FB4CC}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.workflow-value">
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_D4DEE9}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

    </Window.Styles>
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource ThemeBrush_171C22}"
                BorderBrush="{DynamicResource ThemeBrush_2D343F}"
                BorderThickness="0,0,0,1">
            <Grid RowDefinitions="64,66">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Background="{DynamicResource ThemeBrush_151A20}">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" Margin="10,0" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="6" Background="{DynamicResource ThemeBrush_213247}" BorderBrush="{DynamicResource ThemeBrush_3F6C99}" BorderThickness="1">
                            <TextBlock Text="M" Foreground="{DynamicResource ThemeBrush_FFD15A}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="Material Handling System Editor" Foreground="{DynamicResource ThemeBrush_F0F4FA}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Command Workspace" Foreground="{DynamicResource ThemeBrush_738398}" FontSize="10" />
                        </StackPanel>
                    </StackPanel>

                    <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Classes="ribbon-group">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="ribbon-label" Text="FILE" HorizontalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Classes="ribbon-button" Click="OnNewSceneClick" AutomationProperties.Name="New scene">
                                        <StackPanel Spacing="1"><TextBlock Classes="toolbar-icon" Text="✦" /><TextBlock Classes="toolbar-label" Text="New" /></StackPanel>
                                    </Button>
                                    <Button Classes="ribbon-button" Click="OnOpenSceneClick" AutomationProperties.Name="Open scene">
                                        <StackPanel Spacing="1"><TextBlock Classes="toolbar-icon" Text="📂" /><TextBlock Classes="toolbar-label" Text="Open" /></StackPanel>
                                    </Button>
                                    <Button Classes="ribbon-button" Click="OnSaveSceneClick" AutomationProperties.Name="Save scene">
                                        <StackPanel Spacing="1"><TextBlock Classes="toolbar-icon" Text="💾" /><TextBlock Classes="toolbar-label" Text="Save" /></StackPanel>
                                    </Button>
                                    <Button Classes="ribbon-button" Click="OnSaveSceneAsClick" AutomationProperties.Name="Save scene as">
                                        <StackPanel Spacing="1"><TextBlock Classes="toolbar-icon" Text="⇪" /><TextBlock Classes="toolbar-label" Text="Save As" /></StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Classes="ribbon-group">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="ribbon-label" Text="EDIT" HorizontalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Classes="ribbon-button" Command="{Binding UndoCommand}" AutomationProperties.Name="Undo last edit">
                                        <StackPanel Spacing="1"><TextBlock Classes="toolbar-icon" Text="↶" /><TextBlock Classes="toolbar-label" Text="Undo" /></StackPanel>
                                    </Button>
                                    <Button Classes="ribbon-button" Command="{Binding RedoCommand}" AutomationProperties.Name="Redo last edit">
                                        <StackPanel Spacing="1"><TextBlock Classes="toolbar-icon" Text="↷" /><TextBlock Classes="toolbar-label" Text="Redo" /></StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Classes="ribbon-group">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="ribbon-label" Text="RUN" HorizontalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Classes="ribbon-button accent" Command="{Binding RunTestCommand}" AutomationProperties.Name="Run test mode with F5">
                                        <StackPanel Spacing="1"><TextBlock Classes="toolbar-icon" Text="▶" /><TextBlock Classes="toolbar-label" Text="Test F5" /></StackPanel>
                                    </Button>
                                    <Button Classes="ribbon-button" Command="{Binding LoadDemoFactorySceneCommand}" ToolTip.Tip="Load a representative material-handling demo scene" AutomationProperties.Name="Load demo factory scene">
                                        <StackPanel Spacing="1"><TextBlock Classes="toolbar-icon" Text="🏭" /><TextBlock Classes="toolbar-label" Text="Demo" /></StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="10,0" VerticalAlignment="Center">
                        <Menu Background="Transparent" Foreground="{DynamicResource ThemeBrush_DDE7F3}">
                            <MenuItem Header="☰">
                                <MenuItem Header="_Demo Factory Scene" Command="{Binding LoadDemoFactorySceneCommand}" />
                                <Separator />
                                <MenuItem Header="_Settings">
                                    <MenuItem Header="_Application Settings..." Click="OnSettingsClick" />
                                    <Separator />
                                    <MenuItem Header="I want _Blender like settings"
                                              IsChecked="{Binding IsBlenderLikeSettingsActive}"
                                              Command="{Binding BlenderLikeSettingsCommand}" />
                                    <MenuItem Header="I want _AutoCAD like settings"
                                              IsChecked="{Binding IsAutoCadLikeSettingsActive}"
                                              Command="{Binding AutoCadLikeSettingsCommand}" />
                                    <Separator />
                                    <MenuItem Header="OpenGL _GPU Setup..." Click="OnOpenGlGpuSetupClick" />
                                    <Separator />
                                    <MenuItem Header="Use _Software Renderer"
                                              IsChecked="{Binding IsSoftwareViewportMode}"
                                              Command="{Binding UseSoftwareViewportCommand}" />
                                    <MenuItem Header="Use _OpenGL Renderer"
                                              IsChecked="{Binding IsOpenGlViewportMode}"
                                              Command="{Binding UseOpenGlViewportCommand}" />
                                    <Separator />
                                    <MenuItem Header="Show Conveyor _Debug"
                                              IsChecked="{Binding ShowConveyorDebug, Mode=TwoWay}" />
                                </MenuItem>
                                <MenuItem Header="E_xit" Click="OnExitClick" />
                            </MenuItem>
                        </Menu>
                        <Button Classes="ribbon-icon" Click="OnSettingsClick" ToolTip.Tip="Settings">
                            <TextBlock Text="⚙" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Background="{DynamicResource ThemeBrush_20262E}">
                    <Border Grid.Column="0" Classes="ribbon-group">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="ribbon-label" Text="SELECT" HorizontalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Classes="ribbon-button" Classes.accent="{Binding IsSelectActive}" Command="{Binding SelectToolCommand}" AutomationProperties.Name="Select tool">
                                    <StackPanel Spacing="1"><TextBlock Classes="toolbar-icon" Text="☝" /><TextBlock Classes="toolbar-label" Text="Select" /></StackPanel>
                                </Button>
                                <Button Classes="ribbon-button" Classes.accent="{Binding IsMoveActionActive}" Command="{Binding MoveSelectionCommand}" AutomationProperties.Name="Move selection">
                                    <StackPanel Spacing="1"><TextBlock Classes="toolbar-icon" Text="↔" /><TextBlock Classes="toolbar-label" Text="Move" /></StackPanel>
                                </Button>
                                <Button Classes="ribbon-button" Classes.accent="{Binding IsRotateActionActive}" Command="{Binding RotateSelectionCommand}" AutomationProperties.Name="Rotate selection">
                                    <StackPanel Spacing="1"><TextBlock Classes="toolbar-icon" Text="⟳" /><TextBlock Classes="toolbar-label" Text="Rotate" /></StackPanel>
                                </Button>
                                <Button Classes="ribbon-button" Command="{Binding DeleteSelectionCommand}" AutomationProperties.Name="Delete selection">
                                    <StackPanel Spacing="1"><TextBlock Classes="toolbar-icon" Text="⌫" /><TextBlock Classes="toolbar-label" Text="Delete" /></StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,3,8,0" VerticalAlignment="Center">
                            <Button Classes="ribbon-button" Classes.accent="{Binding IsConveyorRouteActive}" Command="{Binding ConveyorRouteToolCommand}" ToolTip.Tip="{Binding ConveyorToolAccessibilityText}" AutomationProperties.Name="{Binding ConveyorToolAccessibilityText}">
                                <StackPanel Spacing="1"><TextBlock Classes="toolbar-icon" Text="▭▭" /><TextBlock Classes="toolbar-label" Text="Conveyor" /></StackPanel>
                            </Button>
                            <Button Classes="ribbon-button" Classes.accent="{Binding IsHopperActive}" Command="{Binding HopperToolCommand}" ToolTip.Tip="{Binding HopperToolAccessibilityText}" AutomationProperties.Name="{Binding HopperToolAccessibilityText}">
                                <StackPanel Spacing="1"><TextBlock Classes="toolbar-icon" Text="▽" /><TextBlock Classes="toolbar-label" Text="Hopper" /></StackPanel>
                            </Button>
                            <Button Classes="ribbon-button" Classes.accent="{Binding IsChuteActive}" Command="{Binding ChuteToolCommand}" ToolTip.Tip="{Binding ChuteToolAccessibilityText}" AutomationProperties.Name="{Binding ChuteToolAccessibilityText}">
                                <StackPanel Spacing="1"><TextBlock Classes="toolbar-icon" Text="╲" /><TextBlock Classes="toolbar-label" Text="Chute" /></StackPanel>
                            </Button>
                            <Button Classes="ribbon-button" Classes.accent="{Binding IsBinActive}" Command="{Binding BinToolCommand}" ToolTip.Tip="{Binding BinToolAccessibilityText}" AutomationProperties.Name="{Binding BinToolAccessibilityText}">
                                <StackPanel Spacing="1"><TextBlock Classes="toolbar-icon" Text="▣" /><TextBlock Classes="toolbar-label" Text="Bin" /></StackPanel>
                            </Button>
                            <Button Classes="ribbon-button" Classes.accent="{Binding IsSplitterActive}" Command="{Binding SplitterToolCommand}" ToolTip.Tip="{Binding SplitterToolAccessibilityText}" AutomationProperties.Name="{Binding SplitterToolAccessibilityText}">
                                <StackPanel Spacing="1"><TextBlock Classes="toolbar-icon" Text="Y" /><TextBlock Classes="toolbar-label" Text="Splitter" /></StackPanel>
                            </Button>
                            <Button Classes="ribbon-button" Classes.accent="{Binding IsLiftActive}" Command="{Binding LiftToolCommand}" ToolTip.Tip="{Binding LiftToolAccessibilityText}" AutomationProperties.Name="{Binding LiftToolAccessibilityText}">
                                <StackPanel Spacing="1"><TextBlock Classes="toolbar-icon" Text="↕" /><TextBlock Classes="toolbar-label" Text="Lift" /></StackPanel>
                            </Button>
                            <Button Classes="ribbon-button" Classes.accent="{Binding IsTurnActive}" Command="{Binding TurnToolCommand}" AutomationProperties.Name="Curve conveyor tool">
                                <StackPanel Spacing="1"><TextBlock Classes="toolbar-icon" Text="⤴" /><TextBlock Classes="toolbar-label" Text="Turn" /></StackPanel>
                            </Button>
                            <Button Classes="ribbon-button" Classes.accent="{Binding IsMergeActive}" Command="{Binding MergeToolCommand}" AutomationProperties.Name="Merge conveyor tool">
                                <StackPanel Spacing="1"><TextBlock Classes="toolbar-icon" Text="⤵" /><TextBlock Classes="toolbar-label" Text="Merge" /></StackPanel>
                            </Button>
                            <Button Classes="ribbon-button" Classes.accent="{Binding IsSupportActive}" Command="{Binding SupportToolCommand}" AutomationProperties.Name="Support frame tool">
                                <StackPanel Spacing="1"><TextBlock Classes="toolbar-icon" Text="▥" /><TextBlock Classes="toolbar-label" Text="Support" /></StackPanel>
                            </Button>
                            <Button Classes="ribbon-button" Command="{Binding OtherPartsCommand}" AutomationProperties.Name="Browse other part tools">
                                <StackPanel Spacing="1"><TextBlock Classes="toolbar-icon" Text="⋯" /><TextBlock Classes="toolbar-label" Text="Other" /></StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Column="2" Classes="ribbon-group">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="ribbon-label" Text="CAMERA" HorizontalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Classes="ribbon-button" Classes.accent="{Binding IsIsoViewActive}" Command="{Binding IsoViewCommand}" AutomationProperties.Name="Isometric camera view">
                                    <StackPanel Spacing="1"><TextBlock Classes="toolbar-icon" Text="◩" /><TextBlock Classes="toolbar-label" Text="Iso" /></StackPanel>
                                </Button>
                                <Button Classes="ribbon-button" Classes.accent="{Binding IsTopViewActive}" Command="{Binding TopViewCommand}" AutomationProperties.Name="Top camera view">
                                    <StackPanel Spacing="1"><TextBlock Classes="toolbar-icon" Text="▤" /><TextBlock Classes="toolbar-label" Text="Top" /></StackPanel>
                                </Button>
                                <Button Classes="ribbon-button" Classes.accent="{Binding IsFrontViewActive}" Command="{Binding FrontViewCommand}" AutomationProperties.Name="Front camera view">
                                    <StackPanel Spacing="1"><TextBlock Classes="toolbar-icon" Text="▦" /><TextBlock Classes="toolbar-label" Text="Front" /></StackPanel>
                                </Button>
                                <Button Classes="ribbon-button" Classes.accent="{Binding IsRightViewActive}" Command="{Binding RightViewCommand}" AutomationProperties.Name="Right camera view">
                                    <StackPanel Spacing="1"><TextBlock Classes="toolbar-icon" Text="▧" /><TextBlock Classes="toolbar-label" Text="Right" /></StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" Margin="8,0,10,0" VerticalAlignment="Center">
                        <TextBlock Classes="ribbon-label" Text="SNAP" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource ThemeBrush_151A20}" BorderBrush="{DynamicResource ThemeBrush_49617A}" BorderThickness="1" CornerRadius="8" Padding="10,5" MinWidth="94" AutomationProperties.Name="Snap grid controls">
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="⌗ Grid" Foreground="{DynamicResource ThemeBrush_E4ECF6}" FontWeight="SemiBold" />
                                <TextBlock DockPanel.Dock="Right" Text="⌄" Foreground="{DynamicResource ThemeBrush_8DA0B7}" Margin="10,0,0,0" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                    <Border Grid.Column="4" Classes="active-tool-pill" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip.Tip="{Binding ActiveToolAccessibilityText}" AutomationProperties.Name="{Binding ActiveToolAccessibilityText}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="●" Foreground="{DynamicResource ThemeBrush_7FDBFF}" />
                            <TextBlock Text="{Binding ActiveToolBadgeText}" Foreground="{DynamicResource ThemeBrush_F7FBFF}" FontWeight="SemiBold" FontSize="11" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ThemeBrush_151A20}" BorderBrush="{DynamicResource ThemeBrush_303844}" BorderThickness="0,1,0,0" Padding="10,3">
            <TextBlock Foreground="{DynamicResource ThemeBrush_C9D3DF}"
                       FontSize="11"
                       Text="{Binding StatusText}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <Grid ColumnDefinitions="330,*,300" Background="{DynamicResource ThemeBrush_1B1D23}">
            <DockPanel Grid.Column="0" Margin="8" LastChildFill="True">
                <Border DockPanel.Dock="Top" Padding="10" Background="{DynamicResource ThemeBrush_20252C}" CornerRadius="4" Margin="0,0,0,6">
                    <StackPanel Spacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Part Catalog" FontWeight="Bold" Foreground="{DynamicResource ThemeBrush_F4F8FD}" FontSize="15" />
                            <TextBlock Text="Transport · Feed &amp; Discharge · Vertical · Structure · Utilities"
                                       Foreground="{DynamicResource ThemeBrush_8FA2B8}"
                                       FontSize="10"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBox PlaceholderText="Search parts by name, function, or synonym..."
                                 Text="{Binding PartSearchText, Mode=TwoWay}"
                                 Background="{DynamicResource ThemeBrush_131922}"
                                 BorderBrush="{DynamicResource ThemeBrush_3B4C61}"
                                 Foreground="{DynamicResource ThemeBrush_E5E9F0}" />
                        <Border IsVisible="{Binding IsCatalogBrowserOpen}"
                                Background="{DynamicResource ThemeBrush_151D27}"
                                BorderBrush="{DynamicResource ThemeBrush_32475B}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Browse catalog" Foreground="{DynamicResource ThemeBrush_E8F1FC}" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="Filter by concept category, then search within the selected group."
                                           Foreground="{DynamicResource ThemeBrush_91A4B8}"
                                           FontSize="10"
                                           TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding PartCatalogCategoryFilters}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PartCatalogCategoryFilterViewModel">
                                            <Button Classes="catalog-filter"
                                                    Classes.selected="{Binding IsSelected}"
                                                    Command="{Binding ApplyCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                    <Border Background="{DynamicResource ThemeBrush_223247}" CornerRadius="8" Padding="5,0">
                                                        <TextBlock Text="{Binding BadgeText}" FontSize="9" Foreground="{DynamicResource ThemeBrush_DDEBFA}" />
                                                    </Border>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding PartCatalogSummaryText}"
                                           Foreground="{DynamicResource ThemeBrush_C8D6E4}"
                                           FontSize="10"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <ScrollViewer MaxHeight="560" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding PartCatalogSections}" HorizontalAlignment="Stretch">
                                <ItemsControl.Styles>
                                    <Style Selector="ContentPresenter">
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    </Style>
                                </ItemsControl.Styles>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PartCatalogSectionViewModel">
                                        <StackPanel Spacing="5" Margin="0,8,0,0" HorizontalAlignment="Stretch">
                                            <Border Background="{DynamicResource ThemeBrush_18212B}"
                                                    BorderBrush="{DynamicResource ThemeBrush_2E3B49}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="0,0,0,4">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{DynamicResource ThemeBrush_9EACBA}"
                                                           FontSize="10"
                                                           FontWeight="Bold" />
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Items}" HorizontalAlignment="Stretch">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.Styles>
                                                    <Style Selector="ContentPresenter">
                                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                                    </Style>
                                                </ItemsControl.Styles>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PartCatalogItemViewModel">
                                                        <Button Classes="part-tile" Command="{Binding ActivateCommand}" ToolTip.Tip="{Binding Description}">
                                                            <StackPanel Spacing="7" HorizontalAlignment="Center" VerticalAlignment="Stretch">
                                                                <Border Width="86"
                                                                        Height="72"
                                                                        Background="{DynamicResource ThemeBrush_121922}"
                                                                        BorderBrush="{DynamicResource ThemeBrush_475B70}"
                                                                        BorderThickness="1.5"
                                                                        CornerRadius="9"
                                                                        HorizontalAlignment="Center">
                                                                    <Image Source="{Binding ThumbnailImage}"
                                                                           Width="76"
                                                                           Height="64"
                                                                           Stretch="Uniform"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                                </Border>
                                                                <TextBlock Text="{Binding DisplayName}"
                                                                           Foreground="{DynamicResource ThemeBrush_DEE6F0}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           TextAlignment="Center"
                                                                           TextWrapping="Wrap"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxLines="2"
                                                                           HorizontalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button Content="{Binding BrowseMorePartsLabel}"
                                Command="{Binding BrowseMorePartsCommand}"
                                Background="{DynamicResource ThemeBrush_233A5A}"
                                Foreground="{DynamicResource ThemeBrush_E8F1FC}"
                                BorderBrush="{DynamicResource ThemeBrush_4A6F9F}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,6" />
                    </StackPanel>
                </Border>

                <Border Padding="8" Background="{DynamicResource ThemeBrush_1A1F29}" CornerRadius="4">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Scene Objects"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource ThemeBrush_ECEFF4}"
                                   FontSize="13"
                                   Margin="0,0,0,6" />
                        <ScrollViewer>
                            <ListBox x:Name="SceneTreeListBox"
                                     ItemsSource="{Binding SceneTreeNodes}"
                                     SelectedItem="{Binding SelectedSceneTreeNode, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     SelectionChanged="OnSceneTreeSelectionChanged"
                                     DoubleTapped="OnSceneTreeDoubleTapped">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="4,3" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="Margin" Value="0,1" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="1" />
                                    </Style>
                                    <Style Selector="ListBoxItem:selected">
                                        <Setter Property="Background" Value="{DynamicResource ThemeBrush_2B3E58}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_88B8FF}" />
                                    </Style>
                                    <Style Selector="ListBoxItem:pointerover:not(:selected)">
                                        <Setter Property="Background" Value="{DynamicResource ThemeBrush_1F2934}" />
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SceneTreeNodeViewModel">
                                        <Panel>
                                            <TextBlock Text="{Binding Label}"
                                                       IsVisible="{Binding IsGroupHeader}"
                                                       Foreground="{DynamicResource ThemeBrush_5E7A94}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Margin="{Binding ContentMargin}" />
                                            <StackPanel IsVisible="{Binding !IsGroupHeader}" Spacing="1" Margin="{Binding ContentMargin}">
                                                <TextBlock Text="{Binding Label}"
                                                           Foreground="{DynamicResource ThemeBrush_C8D8E8}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding StatusText}"
                                                           IsVisible="{Binding HasStatus}"
                                                           Foreground="{DynamicResource ThemeBrush_6FADB5}"
                                                           FontSize="10"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Panel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </DockPanel>

            <Border Grid.Column="1"
                    Grid.ColumnSpan="{Binding SceneViewportColumnSpan}"
                    Margin="8"
                    Background="{Binding ViewportPanelBackground}"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{Binding ViewportPanelBorderBrush}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource ThemeBrush_242830}" BorderBrush="{Binding ViewportPanelBorderBrush}" BorderThickness="0,0,0,1" Padding="10,7">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="Factory View"
                                       Foreground="{DynamicResource ThemeBrush_EEF4FB}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding ViewportSummaryText}"
                                       Foreground="{DynamicResource ThemeBrush_8EA2BA}"
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Background="{Binding ViewportToolbarBackground}" BorderBrush="{Binding ViewportToolbarBorderBrush}" BorderThickness="0,1,0,0" Padding="12,9">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
                            <Border Grid.Column="0" Classes="workflow-card">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="ACTIVE LEVEL" Classes="workflow-label" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <TextBlock Text="Floor" Foreground="{Binding ViewportToolbarTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <RadioButton Content="0" Foreground="{Binding ViewportToolbarControlBrush}" GroupName="FloorSelect" IsChecked="{Binding IsFloor0Active}" Command="{Binding Floor0Command}" />
                                            <RadioButton Content="1" Foreground="{Binding ViewportToolbarControlBrush}" GroupName="FloorSelect" IsChecked="{Binding IsFloor1Active}" Command="{Binding Floor1Command}" />
                                            <RadioButton Content="2" Foreground="{Binding ViewportToolbarControlBrush}" GroupName="FloorSelect" IsChecked="{Binding IsFloor2Active}" Command="{Binding Floor2Command}" />
                                        </StackPanel>
                                        <Border Width="1" Background="{Binding ViewportToolbarSeparatorBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LayerDisplayText}" Foreground="{Binding ViewportToolbarTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <RadioButton Content="0" Foreground="{Binding ViewportToolbarControlBrush}" GroupName="LayerSelect" IsChecked="{Binding IsLayer0Active}" Command="{Binding Layer0Command}" />
                                            <RadioButton Content="1" Foreground="{Binding ViewportToolbarControlBrush}" GroupName="LayerSelect" IsChecked="{Binding IsLayer1Active}" Command="{Binding Layer1Command}" />
                                            <RadioButton Content="2" Foreground="{Binding ViewportToolbarControlBrush}" GroupName="LayerSelect" IsChecked="{Binding IsLayer2Active}" Command="{Binding Layer2Command}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="{Binding AbsoluteZDisplayText}" Foreground="{Binding ViewportToolbarSubtleTextBrush}" FontSize="10" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Classes="workflow-card">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="VIEWPORT" Classes="workflow-label" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <RadioButton Content="Presentation" Foreground="{Binding ViewportToolbarControlBrush}" GroupName="ViewportVisualMode" IsChecked="{Binding IsPresentationViewportVisualMode}" Command="{Binding UsePresentationViewportModeCommand}" />
                                        <RadioButton Content="Technical" Foreground="{Binding ViewportToolbarControlBrush}" GroupName="ViewportVisualMode" IsChecked="{Binding IsTechnicalViewportVisualMode}" Command="{Binding UseTechnicalViewportModeCommand}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <CheckBox Content="Show Grid" IsChecked="{Binding ShowGrid, Mode=TwoWay}" Foreground="{Binding ViewportToolbarControlBrush}" />
                                        <CheckBox Content="Show Bounds" IsChecked="{Binding ShowBounds, Mode=TwoWay}" Foreground="{Binding ViewportToolbarControlBrush}" />
                                        <CheckBox Content="Show Flow" IsChecked="{Binding ShowFlow, Mode=TwoWay}" Foreground="{Binding ViewportToolbarControlBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Classes="workflow-card">
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Text="MATERIAL / FLOW PALETTE" Classes="workflow-label" VerticalAlignment="Center" />
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding MaterialPaletteSummaryText}" Foreground="{Binding ViewportToolbarSubtleTextBrush}" FontSize="10" VerticalAlignment="Center" />
                                            <Button Classes="catalog-tool" Content="Inject" Command="{Binding InjectDebugOreCommand}" />
                                            <Button Classes="catalog-tool" Content="Step" Command="{Binding StepMaterialFlowCommand}" />
                                            <Button Classes="catalog-tool" Content="Clear" Command="{Binding ClearMaterialFlowCommand}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding MaterialTrayItems}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:MaterialTrayItemViewModel">
                                                <Border Margin="0,0,7,0" Padding="7,5" CornerRadius="7" Background="{DynamicResource ThemeBrush_1B2530}" BorderBrush="{DynamicResource ThemeBrush_3C4C5C}" BorderThickness="1">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Border Width="22" Height="22" CornerRadius="5" Background="{Binding TopBrush}" BorderBrush="{Binding EdgeBrush}" BorderThickness="1" />
                                                        <StackPanel Spacing="0">
                                                            <TextBlock Text="{Binding DisplayName}" Foreground="{Binding TextBrush}" FontSize="10.5" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource ThemeBrush_8FA2B8}" FontSize="9.5" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>

                            <Border Grid.Column="3" Classes="workflow-card" MinWidth="240">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="STATUS HINT" Classes="workflow-label" />
                                    <TextBlock Text="{Binding StatusHintText}" Foreground="{Binding ViewportToolbarControlBrush}" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Grid Background="{Binding ViewportSurfaceBackground}">
                    <viewport:SoftwareCubeViewport x:Name="SoftwareViewport"
                                                   IsVisible="{Binding IsSoftwareViewportMode}"
                                                   EditorState="{Binding EditorState}"
                                                       InteractionPreset="{Binding InteractionPreset}" />
                    <viewport:OpenGlViewportControl x:Name="OpenGlViewport"
                                                       IsVisible="{Binding IsOpenGlViewportMode}"
                                                        EditorState="{Binding EditorState}"
                                                        InteractionPreset="{Binding InteractionPreset}" />


                        <Border IsVisible="{Binding FloatingDebugPanelVisible}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="14"
                                MaxWidth="380"
                                Padding="12"
                                Background="{DynamicResource ThemeBrush_D9131820}"
                                BorderBrush="{DynamicResource ThemeBrush_586A82}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Conveyor Debug" FontWeight="Bold" Foreground="{DynamicResource ThemeBrush_F3F6FB}" />
                                <TextBlock Text="{Binding ConveyorDebugSelectionText}" Foreground="{DynamicResource ThemeBrush_D8DEE9}" />
                                <TextBlock Text="{Binding ConveyorDebugRouteSummaryText}" Foreground="{DynamicResource ThemeBrush_BFD2EA}" TextWrapping="Wrap" />
                                <Border Background="{DynamicResource ThemeBrush_0F1217}"
                                        BorderBrush="{DynamicResource ThemeBrush_374657}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8">
                                    <TextBlock Text="{Binding ConveyorDebugGridText}"
                                               Foreground="{DynamicResource ThemeBrush_E5E9F0}"
                                               FontFamily="Consolas"
                                               TextWrapping="NoWrap" />
                                </Border>
                                <TextBlock Text="{Binding ConveyorDebugLegendText}" Foreground="{DynamicResource ThemeBrush_8EACCC}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="Inject DebugOre" Command="{Binding InjectDebugOreCommand}" />
                                    <Button Content="Step Flow" Command="{Binding StepMaterialFlowCommand}" />
                                    <Button Content="Clear Flow" Command="{Binding ClearMaterialFlowCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding InspectorMaterialFlowText}" Foreground="{DynamicResource ThemeBrush_D8DEE9}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    IsVisible="{Binding ExpertInspectorVisible}"
                    Margin="8"
                    Padding="0"
                    Background="{DynamicResource ThemeBrush_232833}"
                    CornerRadius="4">
                <TabControl>
                    <TabItem Header="Inspector">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="10" Margin="10">
                                <Grid ColumnDefinitions="86,*" ColumnSpacing="10">
                                    <Border Grid.Column="0"
                                            Width="78"
                                            Height="78"
                                            Background="{DynamicResource ThemeBrush_111820}"
                                            BorderBrush="{DynamicResource ThemeBrush_3B4C61}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="8">
                                        <Grid>
                                            <Image Source="{Binding SelectedObjectThumbnailImage}"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                            <TextBlock Text="PART"
                                                       Foreground="{DynamicResource ThemeBrush_465569}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Bottom" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding InspectorSelectedText}"
                                                   Foreground="{DynamicResource ThemeBrush_EEF4FB}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <Grid ColumnDefinitions="52,*" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0"
                                                       Text="Name"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource ThemeBrush_AFC6E9}" />
                                            <TextBox x:Name="InspectorNameTextBox"
                                                     Grid.Column="1"
                                                     IsEnabled="{Binding HasSelectedObject}"
                                                     Text="{Binding SelectedObjectName, Mode=TwoWay}"
                                                     GotFocus="OnInspectorNameGotFocus"
                                                     KeyDown="OnInspectorNameKeyDown" />
                                        </Grid>
                                        <Border Background="{DynamicResource ThemeBrush_13251C}"
                                                BorderBrush="{Binding InspectorValidityBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="8,4"
                                                HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="8" Height="8" Fill="{Binding InspectorValidityBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding InspectorValidityText}"
                                                           Foreground="{Binding InspectorValidityBrush}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding InspectorValidityDetail}"
                                                           Foreground="{DynamicResource ThemeBrush_B8C7D9}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <Border Background="{DynamicResource ThemeBrush_1C212A}"
                                        BorderBrush="{DynamicResource ThemeBrush_3B4252}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8">
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="TRANSFORM"
                                                   Foreground="{DynamicResource ThemeBrush_8EA2BA}"
                                                   FontSize="10"
                                                   FontWeight="Bold" />
                                        <Grid ColumnDefinitions="82,*,*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Position" Foreground="{DynamicResource ThemeBrush_AFC6E9}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="0" Grid.Column="1" Watermark="X" IsEnabled="{Binding HasSelectedObject}" Text="{Binding InspectorPositionX, Mode=TwoWay}" />
                                            <TextBox Grid.Row="0" Grid.Column="2" Watermark="Y" IsEnabled="{Binding HasSelectedObject}" Text="{Binding InspectorPositionY, Mode=TwoWay}" />
                                            <TextBox Grid.Row="0" Grid.Column="3" Watermark="Z" IsEnabled="{Binding HasSelectedObject}" Text="{Binding InspectorPositionZ, Mode=TwoWay}" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Rotation" Foreground="{DynamicResource ThemeBrush_AFC6E9}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="1" Grid.Column="1" IsEnabled="{Binding HasSelectedObject}" Text="{Binding InspectorRotationZDegrees, Mode=TwoWay}" />
                                            <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Text="degrees around Z" Foreground="{DynamicResource ThemeBrush_8EA2BA}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Base" Foreground="{DynamicResource ThemeBrush_AFC6E9}" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding InspectorBaseSizeValue}" Foreground="{DynamicResource ThemeBrush_D8DEE9}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Effective" Foreground="{DynamicResource ThemeBrush_AFC6E9}" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding InspectorEffectiveSizeValue}" Foreground="{DynamicResource ThemeBrush_D8DEE9}" TextWrapping="Wrap" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource ThemeBrush_1C212A}"
                                        BorderBrush="{DynamicResource ThemeBrush_3B4252}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8">
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="CONVEYOR"
                                                   Foreground="{DynamicResource ThemeBrush_8EA2BA}"
                                                   FontSize="10"
                                                   FontWeight="Bold" />
                                        <Grid ColumnDefinitions="82,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Length" Foreground="{DynamicResource ThemeBrush_AFC6E9}" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InspectorConveyorLengthText}" Foreground="{DynamicResource ThemeBrush_D8DEE9}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Range" Foreground="{DynamicResource ThemeBrush_AFC6E9}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InspectorConveyorRangeText}" Foreground="{DynamicResource ThemeBrush_D8DEE9}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Speed" Foreground="{DynamicResource ThemeBrush_AFC6E9}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="2" Grid.Column="1" IsEnabled="{Binding SelectedMtrlSrcPanelVisible}" Text="{Binding SelectedMtrlSrcUnitsPerSecondText, Mode=TwoWay}" />
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Direction" Foreground="{DynamicResource ThemeBrush_AFC6E9}" />
                                            <CheckBox Grid.Row="3" Grid.Column="1" IsEnabled="{Binding InspectorConveyorDirectionEditable}" IsChecked="{Binding InspectorConveyorFlowReversed, Mode=TwoWay}" Content="Reverse conveyor flow" Foreground="{DynamicResource ThemeBrush_D8DEE9}" />
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Transfer" Foreground="{DynamicResource ThemeBrush_AFC6E9}" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding InspectorTransferBehaviorText}" Foreground="{DynamicResource ThemeBrush_D8DEE9}" TextWrapping="Wrap" />
                                        </Grid>

                                        <Border IsVisible="{Binding SelectedMtrlSrcPanelVisible}"
                                                Background="{DynamicResource ThemeBrush_172217}"
                                                BorderBrush="{DynamicResource ThemeBrush_6C8F59}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="MATERIAL SOURCE"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource ThemeBrush_A7D397}" />
                                                <TextBlock Text="Edit material and packet settings. Speed is shared with the conveyor Speed field above."
                                                           Foreground="{DynamicResource ThemeBrush_C8D2DE}"
                                                           TextWrapping="Wrap" />
                                                <Grid ColumnDefinitions="80,*" RowDefinitions="Auto" ColumnSpacing="6">
                                                    <TextBlock Grid.Column="0"
                                                               VerticalAlignment="Center"
                                                               Text="Material"
                                                               Foreground="{DynamicResource ThemeBrush_AFC6E9}" />
                                                    <ComboBox Grid.Column="1"
                                                              ItemsSource="{Binding AvailableMtrlSrcMaterialIds}"
                                                              SelectedItem="{Binding SelectedMtrlSrcMaterialId, Mode=TwoWay}" />
                                                </Grid>
                                                <Grid ColumnDefinitions="80,*" RowDefinitions="Auto" ColumnSpacing="6">
                                                   <TextBlock Grid.Column="0"
                                                              VerticalAlignment="Center"
                                                              Text="Granules"
                                                              Foreground="{DynamicResource ThemeBrush_AFC6E9}" />
                                                   <ComboBox Grid.Column="1"
                                                             ItemsSource="{Binding AvailableMtrlSrcGranuleCounts}"
                                                             SelectedItem="{Binding SelectedMtrlSrcGranulesPerPacket, Mode=TwoWay}" />
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                                                    <Button Grid.Column="0" Content="-0.5" Command="{Binding DecreaseSelectedMtrlSrcRateCommand}" />
                                                    <TextBox Grid.Column="1"
                                                             MinWidth="68"
                                                             Text="{Binding SelectedMtrlSrcUnitsPerSecondText, Mode=TwoWay}" />
                                                    <Button Grid.Column="2" Content="+0.5" Command="{Binding IncreaseSelectedMtrlSrcRateCommand}" />
                                                    <Button Grid.Column="3" Content="Apply" Command="{Binding ApplySelectedMtrlSrcRateCommand}" />
                                                </Grid>
                                                <TextBlock Text="{Binding SelectedMtrlSrcRateStatusText}" Foreground="{DynamicResource ThemeBrush_A7D397}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <Border IsVisible="{Binding ConveyorRoutePanelVisible}"
                                                Background="{DynamicResource ThemeBrush_151B23}"
                                                BorderBrush="{DynamicResource ThemeBrush_3B4252}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="ROUTE PREVIEW" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeBrush_8EA2BA}" />
                                                <Grid ColumnDefinitions="88,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="4">
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Anchors" Foreground="{DynamicResource ThemeBrush_AFC6E9}" />
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ConveyorRouteAnchorsValue}" Foreground="{DynamicResource ThemeBrush_D8DEE9}" FontFamily="Consolas" />
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Z Layer" Foreground="{DynamicResource ThemeBrush_AFC6E9}" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConveyorRouteZValue}" Foreground="{DynamicResource ThemeBrush_D8DEE9}" FontFamily="Consolas" />
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Preview" Foreground="{DynamicResource ThemeBrush_AFC6E9}" />
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ConveyorRoutePreviewValue}" Foreground="{DynamicResource ThemeBrush_D8DEE9}" FontFamily="Consolas" />
                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Block" Foreground="{DynamicResource ThemeBrush_AFC6E9}" />
                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ConveyorRouteBlockedReasonValue}" Foreground="{DynamicResource ThemeBrush_D8DEE9}" TextWrapping="Wrap" FontFamily="Consolas" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource ThemeBrush_1C212A}"
                                        BorderBrush="{DynamicResource ThemeBrush_3B4252}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8">
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="VISUAL"
                                                   Foreground="{DynamicResource ThemeBrush_8EA2BA}"
                                                   FontSize="10"
                                                   FontWeight="Bold" />
                                        <Grid ColumnDefinitions="82,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Material" Foreground="{DynamicResource ThemeBrush_AFC6E9}" VerticalAlignment="Center" />
                                            <ComboBox Grid.Row="0" Grid.Column="1" IsEnabled="{Binding SelectedMtrlSrcPanelVisible}" ItemsSource="{Binding AvailableMtrlSrcMaterialIds}" SelectedItem="{Binding SelectedMtrlSrcMaterialId, Mode=TwoWay}" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Paint" Foreground="{DynamicResource ThemeBrush_AFC6E9}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="1" Grid.Column="1" IsEnabled="False" Text="{Binding InspectorPaintText}" />
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Accent" Foreground="{DynamicResource ThemeBrush_AFC6E9}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="2" Grid.Column="1" IsEnabled="False" Text="{Binding InspectorAccentColorText}" />
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Type" Foreground="{DynamicResource ThemeBrush_AFC6E9}" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding InspectorPartTypeText}" Foreground="{DynamicResource ThemeBrush_D8DEE9}" TextWrapping="Wrap" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Expander Header="Advanced diagnostics" IsExpanded="False">
                                    <Border Background="{DynamicResource ThemeBrush_151B23}"
                                            BorderBrush="{DynamicResource ThemeBrush_3B4252}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{Binding InspectorIdText}" Foreground="{DynamicResource ThemeBrush_D8DEE9}" />
                                            <TextBlock Text="{Binding InspectorDiagnosticPositionText}" Foreground="{DynamicResource ThemeBrush_D8DEE9}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding InspectorDiagnosticSizeText}" Foreground="{DynamicResource ThemeBrush_D8DEE9}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding InspectorDiagnosticEffectiveSizeText}" Foreground="{DynamicResource ThemeBrush_D8DEE9}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding InspectorDiagnosticRotationText}" Foreground="{DynamicResource ThemeBrush_D8DEE9}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding InspectorDiagnosticZSpanText}" Foreground="{DynamicResource ThemeBrush_D8DEE9}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding InspectorDiagnosticRangeText}" Foreground="{DynamicResource ThemeBrush_D8DEE9}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding InspectorDiagnosticExtraText}" Foreground="{DynamicResource ThemeBrush_D8DEE9}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding InspectorPortText}" Foreground="{DynamicResource ThemeBrush_D8DEE9}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding InspectorMaterialFlowText}" Foreground="{DynamicResource ThemeBrush_D8DEE9}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Scene">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="8" Margin="10">
                                <TextBlock Text="FLOOR / LAYER"
                                           Foreground="{DynamicResource ThemeBrush_8EA2BA}"
                                           FontSize="10"
                                           FontWeight="Bold" />
                                <Border Background="{Binding Floor2StackBackground}" BorderBrush="{Binding Floor2StackBorder}" BorderThickness="1" CornerRadius="4" Padding="6,4">
                                    <Button Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Command="{Binding Floor2Command}">
                                        <TextBlock Text="{Binding Floor2StackText}" Foreground="{DynamicResource ThemeBrush_D8DEE9}" />
                                    </Button>
                                </Border>
                                <Border Background="{Binding Floor1StackBackground}" BorderBrush="{Binding Floor1StackBorder}" BorderThickness="1" CornerRadius="4" Padding="6,4">
                                    <Button Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Command="{Binding Floor1Command}">
                                        <TextBlock Text="{Binding Floor1StackText}" Foreground="{DynamicResource ThemeBrush_D8DEE9}" />
                                    </Button>
                                </Border>
                                <Border Background="{Binding Floor0StackBackground}" BorderBrush="{Binding Floor0StackBorder}" BorderThickness="1" CornerRadius="4" Padding="6,4">
                                    <Button Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Command="{Binding Floor0Command}">
                                        <TextBlock Text="{Binding Floor0StackText}" Foreground="{DynamicResource ThemeBrush_D8DEE9}" />
                                    </Button>
                                </Border>
                                <Grid ColumnDefinitions="94,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="5" Margin="0,6,0,0">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Active floor" Foreground="{DynamicResource ThemeBrush_AFC6E9}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ActiveFloorSummaryText}" Foreground="{DynamicResource ThemeBrush_D8DEE9}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Active layer" Foreground="{DynamicResource ThemeBrush_AFC6E9}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ActiveLayerSummaryText}" Foreground="{DynamicResource ThemeBrush_D8DEE9}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Absolute Z" Foreground="{DynamicResource ThemeBrush_AFC6E9}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ActiveAbsoluteZSummaryText}" Foreground="{DynamicResource ThemeBrush_D8DEE9}" TextWrapping="Wrap" />
                                </Grid>
                                <Expander Header="Advanced renderer diagnostics"
                                          IsExpanded="False"
                                          IsVisible="{Binding ExpertGpuLabelsVisible}">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Renderer" Foreground="{DynamicResource ThemeBrush_AFC6E9}" FontSize="11" VerticalAlignment="Center" />
                                            <RadioButton Content="Software" GroupName="RendererMode" IsChecked="{Binding IsSoftwareViewportMode}" Command="{Binding UseSoftwareViewportCommand}" />
                                            <RadioButton Content="OpenGL" GroupName="RendererMode" IsChecked="{Binding IsOpenGlViewportMode}" Command="{Binding UseOpenGlViewportCommand}" />
                                        </StackPanel>
                                        <CheckBox Content="Show Conveyor Debug"
                                                  IsChecked="{Binding ShowConveyorDebug, Mode=TwoWay}"
                                                  Foreground="{DynamicResource ThemeBrush_C7D1DD}" />
                                        <TextBlock Text="{Binding PreferredOpenGlGpuSummaryText}" Foreground="{DynamicResource ThemeBrush_AFC6E9}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding OpenGlBackendSummaryText}" Foreground="{DynamicResource ThemeBrush_AFC6E9}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </DockPanel>
</Window>
